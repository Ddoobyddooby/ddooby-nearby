# 로컬 개발 전용. 실제 키는 .env에만 보관한다.
APP_NAME=ddooby-nearby
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://nearby:nearby@localhost:5432/nearby
POSTGRES_DB=nearby
POSTGRES_USER=nearby
POSTGRES_PASSWORD=nearby
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_KAKAO_MAP_APP_KEY=
USE_MOCK_DATA=true
DEFAULT_REGION=dasan-jigeum
DEFAULT_SEARCH_RADIUS_M=2000
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
